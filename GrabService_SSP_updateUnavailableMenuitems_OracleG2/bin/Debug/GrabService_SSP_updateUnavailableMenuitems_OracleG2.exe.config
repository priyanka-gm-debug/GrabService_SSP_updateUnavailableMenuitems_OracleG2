<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
	</startup>

	<connectionStrings>
		<!-- Example for SQL Server for external stage:ohio-stage-sql.grabmobilewebtop.com,1451 for external prod:ohio-sql.grabmobilewebtop.com
		internal prod:ohio-listener.getgrab.local
		added internale name here as that will be known onto the server where scheduler is running.-->
		<add name="SqlConnectionString"
			 connectionString="Data Source=ohio-stage-sql.grabmobilewebtop.com,1451;Initial Catalog=Cursus;User ID=ServyAPI;Password=RushSignals$82;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<appSettings>
		<!-- Optional: Add key-value settings here -->
		<add key="RetryIntervalMilliseconds" value="1000"/>
		<add key="EnableDebugLogs" value="true"/>
		<add key="LogFilePath" value="C:\Temp\POS_SSP_Unavailable_MenuItems.txt"/>
	</appSettings>
</configuration>